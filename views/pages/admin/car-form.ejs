<%- include("../../partials/head") %>
<%- include("../../partials/header") %>
<%- include("../../partials/admin-nav", {
  adminTitle: car ? "Редактирование автомобиля" : "Добавление автомобиля",
  adminDescription: "Рабочая форма для карточки автомобиля без лишнего декора."
}) %>

<section class="admin-section">
  <div class="container narrow">
    <div class="admin-panel">
      <form method="post" class="stack-form admin-form-grid" action="<%= car ? `/admin/cars/${car.id}/edit` : '/admin/cars/new' %>">
        <div class="field"><label>Марка</label><input name="brand" value="<%= car?.brand || '' %>" required></div>
        <div class="field"><label>Модель</label><input name="model" value="<%= car?.model || '' %>" required></div>
        <div class="field"><label>Slug</label><input name="slug" value="<%= car?.slug || '' %>" placeholder="можно оставить пустым"></div>
        <div class="field"><label>Год</label><input name="year" type="number" value="<%= car?.year || '' %>" required></div>
        <div class="field"><label>Пробег</label><input name="mileage" type="number" value="<%= car?.mileage || '' %>" required></div>
        <div class="field"><label>Двигатель</label><input name="engine" value="<%= car?.engine || '' %>" required></div>
        <div class="field"><label>Кузов</label><input name="body_type" value="<%= car?.body_type || '' %>" required></div>
        <div class="field"><label>Коробка</label><input name="transmission" value="<%= car?.transmission || '' %>" required></div>
        <div class="field"><label>Цена</label><input name="price" type="number" value="<%= car?.price || '' %>" required></div>
        <div class="field"><label>Ссылка на изображение</label><input name="image_url" value="<%= car?.image_url || '/static/images/hero-mercedes.jpg' %>" required></div>
        <div class="field"><label>Статус</label><input name="status" value="<%= car?.status || 'active' %>" required></div>
        <div class="field"><label>Показывать в спецблоке</label><select name="featured"><option value="0">Нет</option><option value="1" <%= car?.featured ? 'selected' : '' %>>Да</option></select></div>
        <div class="field field-full"><label>Описание</label><textarea name="description" rows="6" required><%= car?.description || '' %></textarea></div>
        <div class="field field-full admin-form-actions">
          <button type="submit" class="btn btn-primary">Сохранить</button>
          <a href="/admin/cars" class="btn btn-secondary">Назад к списку</a>
        </div>
      </form>
    </div>
  </div>
</section>

<%- include("../../partials/footer") %>
