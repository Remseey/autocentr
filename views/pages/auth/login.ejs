<%- include("../../partials/head") %>
<%- include("../../partials/header") %>

<section class="auth-section">
  <div class="container narrow">
    <div class="panel reveal">
      <p class="eyebrow">Авторизация</p>
      <h1 class="section-title">Вход в PRIMECAR</h1>
      <% if (errors.length) { %>
        <div class="flash flash-error"><%= errors[0].msg %></div>
      <% } %>
      <form method="post" action="/login" class="stack-form">
        <div class="field">
          <label for="email">Email</label>
          <input id="email" type="email" name="email" value="<%= formData.email || '' %>" required>
        </div>
        <div class="field">
          <label for="password">Пароль</label>
          <input id="password" type="password" name="password" required>
        </div>
        <button type="submit" class="btn btn-primary">Войти</button>
      </form>
      <p class="muted">Нет аккаунта? <a href="/register">Создать</a></p>
    </div>
  </div>
</section>

<%- include("../../partials/footer") %>
